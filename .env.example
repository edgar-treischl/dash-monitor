# Grafana Configuration
GRAFANA_ADMIN_PASSWORD=admin

# Data Retention (in days)
TEMPO_RETENTION=7d
LOKI_RETENTION=7d

# Resource Limits
COLLECTOR_MEMORY_LIMIT=2G
TEMPO_MEMORY_LIMIT=2G
LOKI_MEMORY_LIMIT=2G
GRAFANA_MEMORY_LIMIT=1G

# Network Configuration
COLLECTOR_HTTP_PORT=4318
COLLECTOR_GRPC_PORT=4317
GRAFANA_PORT=3000
TEMPO_PORT=3200
LOKI_PORT=3100
